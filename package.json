{
  "name": "nepal-civic-intelligence-graph",
  "version": "3.0.0",
  "description": "National-level civic intelligence platform for Nepal",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "build": "npm run build --workspace=frontend",
    "preview": "npm -w frontend run preview",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
