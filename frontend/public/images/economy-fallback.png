<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 450" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#062419" />
      <stop offset="50%" stop-color="#064e3b" />
      <stop offset="100%" stop-color="#059669" />
    </linearGradient>
    <linearGradient id="glowGrad" x1="0%" y1="100%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#10b981" stop-opacity="0.35" />
      <stop offset="100%" stop-color="#10b981" stop-opacity="0" />
    </linearGradient>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(255,255,255,0.04)" stroke-width="1" />
    </pattern>
  </defs>

  <!-- Background -->
  <rect width="800" height="450" fill="url(#bgGrad)" />
  <rect width="800" height="450" fill="url(#grid)" />
  <circle cx="700" cy="80" r="280" fill="url(#glowGrad)" filter="blur(40px)" />
  <circle cx="100" cy="400" r="200" fill="url(#glowGrad)" filter="blur(50px)" />

  <!-- Diagonal Geometric Accent Lines -->
  <line x1="-50" y1="450" x2="450" y2="-50" stroke="#10b981" stroke-opacity="0.12" stroke-width="2" />
  <line x1="50" y1="500" x2="550" y2="0" stroke="#10b981" stroke-opacity="0.08" stroke-width="1.5" />

  <!-- Centered Emblem & Details (Optimized for both 16:9 Widescreen AND Square Thumbnails!) -->
  <g transform="translate(400, 225)" text-anchor="middle">
    <!-- Center Glow Circle -->
    <circle cx="0" cy="-25" r="110" fill="#10b981" fill-opacity="0.22" filter="blur(20px)" />
    <circle cx="0" cy="-25" r="70" fill="#064e3b" stroke="#10b981" stroke-width="2.5" stroke-opacity="0.8" />

    <!-- Big Center Icon -->
    <text x="0" y="2" font-size="66" text-anchor="middle">📈</text>

    <!-- Category Label -->
    <text x="0" y="80" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="22" font-weight="900" fill="#ffffff" letter-spacing="1.5" text-anchor="middle">ECONOMY & COMMERCE</text>

    <!-- Subtitle -->
    <text x="0" y="108" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="13" font-weight="600" fill="#cbd5e1" letter-spacing="0.5" text-anchor="middle">Nepal Rastra Bank • Stock Market • Trade & Revenue</text>
  </g>
</svg>