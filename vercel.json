{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build --workspace=frontend",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/rss",
      "destination": "/api/rss"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
